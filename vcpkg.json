{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "skyui-inventory-optimizer",
  "version-string": "0.0.1",
  "description": "SkyUI Inventory Optimizer - native SKSE plugin that takes over SkyUI inventory item-card filling",
  "homepage": "https://github.com/Fengzi2333/SkyUI-Inventory-Optimizer",
  "features": {
    "plugin": {
      "description": "SKSE plugin",
      "dependencies": [
        "spdlog"
      ]
    },
    "detours": {
      "description": "Microsoft Detours for chainable entry hooks (opt-in: -DVCPKG_MANIFEST_FEATURES=detours)",
      "dependencies": [
        "detours"
      ]
    },
    "clibng-support": {
        "description": "clibng dependencies",
        "dependencies": [
            "directxtk",
            "rapidcsv"
        ]
    }
  },
  "default-features": [
    "plugin",
    "clibng-support"
  ],
  "builtin-baseline": "9e593bb18ea69cc5095e012465dcd675a822ed0d"
}
