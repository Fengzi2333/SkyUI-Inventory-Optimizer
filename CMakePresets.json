{
  "version": 5,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "buildPresets": [
    {
      "name": "release",
      "displayName": "Release NG",
      "configurePreset": "default",
      "configuration": "Release"
    },
    {
      "name": "debug",
      "displayName": "Debug NG",
      "configurePreset": "default",
      "configuration": "Debug"
    },
    {
      "name": "relwithdebinfo",
      "displayName": "RelWithDebInfo NG",
      "configurePreset": "default",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "release-novr",
      "displayName": "Release NG-NoVR",
      "configurePreset": "no-vr",
      "description": "Force clibng-sse build without VR",
      "configuration": "Release"
    },
    {
      "name": "debug-novr",
      "displayName": "Debug NG-NoVR",
      "configurePreset": "no-vr",
      "description": "Force clibng-sse build without VR",
      "configuration": "Debug"
    },
    {
      "name": "relwithdebinfo-novr",
      "displayName": "RelWithDebInfo NG-NoVR",
      "configurePreset": "no-vr",
      "description": "Force clibng-sse build without VR",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "release-vr",
      "displayName": "Release VR",
      "configurePreset": "vr",
      "description": "Force clibng-sse build with VR",
      "configuration": "Release"
    },
    {
      "name": "debug-vr",
      "displayName": "Debug VR",
      "configurePreset": "vr",
      "description": "Force clibng-sse build with VR",
      "configuration": "Debug"
    },
    {
      "name": "relwithdebinfo-vr",
      "displayName": "RelWithDebInfo VR",
      "configurePreset": "vr",
      "description": "Force clibng-sse build with VR",
      "configuration": "RelWithDebInfo"
    }
  ],
  "configurePresets": [
    {
      "name": "common",
      "hidden": true,
      "binaryDir": "${sourceDir}/build",
      "installDir": "${sourceDir}/build/install"
    },
    {
      "name": "vcpkg",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": {
          "type": "STRING",
          "value": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
        },
        "VCPKG_OVERLAY_PORTS": {
          "type": "STRING",
          "value": "${sourceDir}/cmake/ports/"
        },
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md"
      }
    },
    {
      "name": "win64",
      "hidden": true,
      "architecture": "x64",
      "cacheVariables": {
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL"
      }
    },
    {
      "name": "msvc",
      "hidden": true,
      "description": "MSVC x64. Generator 'Visual Studio 18 2026' because VS 18 is the only Visual Studio installed on this machine (there is no VS 2022, so the VS 17 2022 generator is unusable). Toolset is pinned to v143 (MSVC 14.44) because that is the toolset SKSE plugins / CommonLibSSE-NG are built with and what this project used before; VS 18 also ships v145 (MSVC 14.50), which would otherwise silently become the default.",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "/EHsc /MP /W4 /WX $penv{CXXFLAGS}"
      },
      "generator": "Visual Studio 18 2026",
      "toolset": "v143",
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "intelliSenseMode": "windows-msvc-x64",
          "enableMicrosoftCodeAnalysis": true,
          "enableClangTidyCodeAnalysis": true
        }
      }
    },
    {
      "name": "build-ng",
      "hidden": true,
      "cacheVariables": {
        "SKYRIM_SUPPORT_AE": "ON",
        "ENABLE_SKYRIM_AE": "ON",
        "ENABLE_SKYRIM_SE": "ON"
      }
    },
    {
      "name": "build-vr",
      "hidden": true,
      "cacheVariables": {
        "ENABLE_SKYRIM_VR": "ON"
      }
    },
    {
      "name": "build-novr",
      "hidden": true,
      "cacheVariables": {
        "ENABLE_SKYRIM_VR": "OFF"
      }
    },
    {
      "name": "default",
      "hidden": false,
      "inherits": [
        "common",
        "vcpkg",
        "win64",
        "msvc",
        "build-ng"
      ]
    },
    {
      "name": "vr",
      "hidden": false,
      "inherits": [
        "common",
        "vcpkg",
        "win64",
        "msvc",
        "build-vr"
      ]
    },
    {
      "name": "no-vr",
      "hidden": false,
      "inherits": [
        "common",
        "vcpkg",
        "win64",
        "msvc",
        "build-ng",
        "build-novr"
      ]
    }
  ]
}
